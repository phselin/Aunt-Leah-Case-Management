# API / Worker configuration
MONGO_URI=mongodb://mongo:27017/auntleah
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# External services
GOTENBERG_URL=http://gotenberg:3000
PANDOC_URL=http://pandoc:3100

# Shared output directory inside containers
OUTPUT_DIR=/outputs

# Host port mappings (optional; used by compose.yaml)
API_PORT=8000
PANDOC_PORT=3100
GOTENBERG_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379

